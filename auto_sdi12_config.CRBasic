' Automatically detect SDI-12 sensor type and datalogger location
' Example program for CR300 datalogger

Public LoggerSN As String * 20
Public Locatie_code As String * 50

' Example arrays to hold sensor data
Public Sensor_ID(4) As String * 50
Public Sensor_Type(4) As String * 10
Public Sensor_SN(4) As String * 20

Const SDI12_port = C1

BeginProg
    'Read logger serial number
    LoggerSN = Status.SerialNumber(1,1)

    'Lookup location code based on serial number
    If LoggerSN = "12345" Then
        Locatie_code = "test/S7468"
    ElseIf LoggerSN = "67890" Then
        Locatie_code = "test/S8123"
    Else
        Locatie_code = "test/unknown"
    EndIf

    'Detect sensor type for addresses 1..4
    Dim addr As String
    For addr_num = 1 To 4
        addr = Str(addr_num)
        SDI12Recorder(Sensor_ID(addr_num), SDI12_port, addr, "I!", 1.0, 0)
        If Sensor_ID(addr_num) <> "NAN" Then
            Sensor_Type(addr_num) = Mid(Sensor_ID(addr_num),12,3)
            Sensor_SN(addr_num) = Right(Sensor_ID(addr_num),7)
        EndIf
        Delay(0,1,Sec)

    'Construct output filenames including location and sensor type
    Dim Tijd_code As String * 30
    Tijd_code = "_" & Status.Year & FormatFloat(Status.Month, "%02.0f") & FormatFloat(Status.Day, "%02.0f")
    For i = 1 To 4
        If Sensor_SN(i) <> "" Then
            RemoteFileName(i) = Locatie_code & "_AT" & Sensor_Type(i) & "_" & Sensor_SN(i) & Tijd_code & ".dat"
        EndIf
    Next i

EndProg
